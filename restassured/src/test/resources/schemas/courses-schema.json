{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Instructor Courses Response",
  "type": "object",
  "required": ["instructor", "url", "services", "expertise", "courses", "linkedIn"],
  "additionalProperties": false,
  "properties": {
    "instructor": { "type": "string", "minLength": 1 },
    "url":        { "type": "string", "minLength": 1 },
    "services":   { "type": "string", "minLength": 1 },
    "expertise":  { "type": "string", "minLength": 1 },
    "courses": {
      "type": "object",
      "required": ["webAutomation", "api", "mobile"],
      "additionalProperties": false,
      "properties": {
        "webAutomation": { "$ref": "#/definitions/courseList" },
        "api":           { "$ref": "#/definitions/courseList" },
        "mobile":        { "$ref": "#/definitions/courseList" }
      }
    },
    "linkedIn": { "type": "string", "format": "uri" }
  },
  "definitions": {
    "courseList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/course" }
    },
    "course": {
      "type": "object",
      "required": ["courseTitle", "price"],
      "additionalProperties": false,
      "properties": {
        "courseTitle": { "type": "string", "minLength": 1 },
        "price": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]{1,2})?$",
          "description": "Numeric price sent as a string, e.g. \"50\""
        }
      }
    }
  }
}
